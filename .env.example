# AI Knowledge Base Environment Variables
# Copy this file to .env and fill in your actual values

# ==============================================================================
# Unified Memory API (PRIMARY storage path — notes + memories)
# ==============================================================================

# Unified Memory API base URL (VPS)
MEMORY_BASE_URL=http://85.25.172.47:8085

# Bearer token for authentication
MEMORY_TOKEN=

# Agent ID for X-Agent-ID header
MEMORY_AGENT_ID=openclaw-main

# ==============================================================================
# Legacy Database Configuration (PostgreSQL with pgvector — read-only)
# ==============================================================================

# Individual DB fields
DB_HOST=85.25.172.47
DB_PORT=5433
DB_NAME=aidb
DB_USER=ai_admin
DB_PASSWORD=

# Database schema name
DB_SCHEMA=ai_kb

# ==============================================================================
# API Server Configuration (Optional - for remote VPS deployment)
# ==============================================================================

# API server URL (if using remote deployment)
API_SERVER_URL=http://your-vps-ip:8085

# API key for authentication
API_KEY=your-secure-api-key-here

# ==============================================================================
# YouTube API (Optional - for enhanced metadata)
# ==============================================================================

# YouTube Data API v3 key
# Only needed for fetching video metadata beyond basic transcript extraction
# Get one from: https://console.cloud.google.com/apis/credentials
# YOUTUBE_API_KEY=your_youtube_api_key_here

# ==============================================================================
# Embedding Model Configuration
# ==============================================================================

# Embedding model (unified-memory uses nomic-embed-text via Ollama on gaming-pc)
EMBEDDING_MODEL=nomic-embed-text

# Embedding dimension (768 for nomic-embed-text)
EMBEDDING_DIM=768

# ==============================================================================
# Processing Settings
# ==============================================================================

# Default chunk size in characters
CHUNK_SIZE=300

# Overlap between chunks in characters
CHUNK_OVERLAP=50

# Minimum quality score for chunks (0.0 to 1.0)
MIN_CHUNK_QUALITY=0.3

# ==============================================================================
# Audio Transcription (Optional - for Vimeo/conference audio)
# ==============================================================================

# AssemblyAI API key for audio transcription
# Get your free API key at: https://www.assemblyai.com/
# Free tier: 100 hours of transcription
# ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# ==============================================================================
# Automation (Optional - for n8n integration)
# ==============================================================================

# n8n webhook URL for automated video processing notifications
# Default: https://n8n.vecia.fr/webhook/ai-kb-video-insights
N8N_WEBHOOK_URL=https://n8n.vecia.fr/webhook/ai-kb-video-insights

# ==============================================================================
# Development Settings (Optional)
# ==============================================================================

# Set to 'development' or 'production'
# ENVIRONMENT=development

# Enable debug logging
# DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO
