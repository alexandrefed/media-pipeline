# AI Knowledge Base Environment Variables
# Copy this file to .env and fill in your actual values

# ==============================================================================
# Database Configuration (PostgreSQL with pgvector)
# ==============================================================================

# Full database connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host:5433/your_database_name

# Database schema name
DB_SCHEMA=ai_kb

# ==============================================================================
# API Server Configuration (Optional - for remote VPS deployment)
# ==============================================================================

# API server URL (if using remote deployment)
API_SERVER_URL=http://your-vps-ip:8001

# API key for authentication
API_KEY=your-secure-api-key-here

# ==============================================================================
# YouTube API (Optional - for enhanced metadata)
# ==============================================================================

# YouTube Data API v3 key
# Only needed for fetching video metadata beyond basic transcript extraction
# Get one from: https://console.cloud.google.com/apis/credentials
# YOUTUBE_API_KEY=your_youtube_api_key_here

# ==============================================================================
# Embedding Model Configuration
# ==============================================================================

# Sentence transformer model for vector embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Embedding dimension (384 for all-MiniLM-L6-v2)
EMBEDDING_DIM=384

# ==============================================================================
# Processing Settings
# ==============================================================================

# Default chunk size in characters
CHUNK_SIZE=300

# Overlap between chunks in characters
CHUNK_OVERLAP=50

# Minimum quality score for chunks (0.0 to 1.0)
MIN_CHUNK_QUALITY=0.3

# ==============================================================================
# Automation (Optional - for n8n integration)
# ==============================================================================

# n8n webhook URL for automated video processing notifications
# N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/video-processed

# ==============================================================================
# Development Settings (Optional)
# ==============================================================================

# Set to 'development' or 'production'
# ENVIRONMENT=development

# Enable debug logging
# DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO
